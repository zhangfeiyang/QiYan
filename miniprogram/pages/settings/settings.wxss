.page{padding:28rpx}.section{padding:28rpx;margin-bottom:24rpx}.title{display:block;font-size:32rpx;font-weight:800;margin-bottom:14rpx}.help{display:block;font-size:22rpx;color:#78685f;line-height:1.6;margin-bottom:24rpx}.label{display:block;font-size:23rpx;margin:18rpx 0 8rpx}.section input{height:76rpx;border-radius:14rpx;background:#fff9ed;padding:0 18rpx;font-size:23rpx}.section button{margin-top:24rpx}.feature{display:flex;justify-content:space-between;align-items:center;border-bottom:1rpx solid rgba(80,55,40,.1);padding:18rpx 0;font-size:25rpx}.roadmap{display:block;font-size:19rpx;color:#907b6e;margin-top:5rpx}.state{font-size:20rpx;padding:6rpx 12rpx;border-radius:14rpx}.done{color:#286642;background:#dcecdf}.pending{color:#8a602b;background:#f0e1c5}.fingerprint{display:block;text-align:center;color:#a18d82;font-size:18rpx;margin-top:20rpx}
