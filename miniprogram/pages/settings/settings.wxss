.section {
  margin-top: var(--space-3);
}

.section-title {
  display: block;
  margin-bottom: var(--space-2);
}

.row {
  display: flex;
  align-items: center;
  min-height: var(--touch-min);
  padding: var(--space-2) 0;
}

.row-body {
  flex: 1;
  min-width: 0;
  padding-right: var(--space-3);
}
/* 开关标题下面紧跟一行说明: 只有两个字的标题说不清这个开关到底管什么 */
.row-body .t-label {
  display: block;
  margin-top: 4rpx;
  line-height: 1.4;
}

.danger-text { color: var(--danger); }

.theme-title {
  display: block;
  margin-top: var(--space-4);
}

.theme-group {
  display: flex;
  margin-top: var(--space-2);
  background: var(--surface-sunken);
  border-radius: var(--radius-md);
  padding: 4rpx;
}

.theme-option {
  flex: 1;
  text-align: center;
  padding: var(--space-2) 0;
  border-radius: var(--radius-sm);
  font-size: var(--text-body-sm);
  color: var(--text-secondary);
}
.theme-option.active {
  background: var(--action);
  color: var(--text-on-action);
  font-weight: bold;
}

.help {
  display: block;
  line-height: 1.55;
  margin-bottom: var(--space-2);
}

.field-label {
  display: block;
  margin-top: var(--space-3);
}

.field {
  margin-top: var(--space-1);
  height: 80rpx;
  padding: 0 var(--space-3);
  background: var(--surface-sunken);
  border-radius: var(--radius-md);
  font-size: var(--text-body-sm);
  color: var(--text-primary);
}

.save { margin-top: var(--space-4); }

.feature {
  display: flex;
  align-items: center;
  padding: var(--space-2) 0;
}

.feature-body { flex: 1; min-width: 0; }
.feature-body .t-label { display: block; margin-top: 2rpx; }

.state {
  font-size: var(--text-caption);
  font-weight: bold;
  padding: 2rpx var(--space-2);
  border-radius: var(--radius-pill);
}
.state.ready { color: var(--action); background: var(--action-muted); }
.state.pending { color: var(--warning); background: var(--surface-sunken); }

.fingerprint {
  display: block;
  margin-top: var(--space-3);
}
