<scroll-view class="screen {{themeClass}}" scroll-y>
  <view class="scroll-body">

    <!-- ============ 档案卡 ============ -->
    <!-- 主角是段位名而不是裸分数: 裸分数看着像一个已经标定好的外部量表,
         段位名至少不虚报精度。胜率条让胜/负/和从三个孤立数字变成走势。 -->
    <view class="card profile">
      <text class="t-title">{{nickname}}</text>
      <text class="rank" style="color: {{rankColor}}">{{rankName}}</text>
      <text class="t-label">{{T.rating_current}}</text>

      <view class="winrate-bar">
        <view class="seg win" style="flex-grow: {{winWeight}}" />
        <view class="seg loss" style="flex-grow: {{lossWeight}}" />
        <view class="seg draw" style="flex-grow: {{drawWeight}}" />
      </view>

      <view class="legend">
        <text class="legend-win">{{winsText}}</text>
        <text class="legend-loss">{{lossesText}}</text>
        <text class="legend-draw">{{drawsText}}</text>
      </view>
      <text class="t-label games">{{gamesText}}</text>
    </view>

    <!-- ============ 主行动 ============ -->
    <button class="btn btn-primary play" bindtap="startGame">
      <x-icon name="play" token="textOnAction" theme="{{theme}}" size="44" />
      <text class="play-text">{{playText}}</text>
    </button>

    <!-- ============ 实时支招: 独占一行 ============ -->
    <!-- 它是唯一"举着手机对着真实棋盘"的功能, 和另外两个"在手机里看棋"的
         入口不是一回事, 塞进双列会被当成同类。四个字说不清它干什么,
         所以配一句副标题。 -->
    <view class="card entry-live" bindtap="appOnly">
      <x-icon name="live" token="action" theme="{{theme}}" size="48" />
      <view class="entry-live-body">
        <view class="entry-live-title">
          <text class="t-title">{{T.live_entry}}</text>
          <text class="app-badge">App</text>
        </view>
        <text class="t-label">{{T.menu_live_desc}}</text>
      </view>
    </view>

    <!-- ============ 平级功能: 双列 ============ -->
    <view class="pair">
      <button class="btn btn-outlined" bindtap="openReplay">
        <x-icon name="history" theme="{{theme}}" size="36" />
        <text class="pair-text">{{T.menu_replay}}</text>
      </button>
      <button class="btn btn-outlined" bindtap="appOnly">
        <x-icon name="camera" theme="{{theme}}" size="36" />
        <text class="pair-text">{{T.menu_recognize}}</text>
        <text class="app-badge">App</text>
      </button>
    </view>

    <!-- ============ 低频入口 ============ -->
    <view class="low-row">
      <button class="btn btn-text" bindtap="openSettings">
        <x-icon name="settings" theme="{{theme}}" size="34" />
        <text class="low-text">{{T.menu_settings}}</text>
      </button>
      <button class="btn btn-text" bindtap="showAbout">
        <x-icon name="info" theme="{{theme}}" size="34" />
        <text class="low-text">{{T.menu_about}}</text>
      </button>
      <button class="btn btn-text" bindtap="toggleLanguage">
        <x-icon name="language" theme="{{theme}}" size="34" />
        <text class="low-text">{{T.menu_language}}</text>
      </button>
    </view>

  </view>
</scroll-view>
