.page{padding:44rpx 32rpx 60rpx}.hero{display:flex;flex-direction:column;align-items:center;padding:30rpx 0 44rpx}.eyebrow{font-size:20rpx;letter-spacing:5rpx;color:#9b6b4d}.title{font-size:94rpx;font-family:serif;font-weight:900;color:#6f241d;line-height:1.2}.subtitle{font-size:26rpx;color:#765f50}.profile{padding:30rpx;display:flex;justify-content:space-between;align-items:end}.label{display:block;font-size:22rpx;color:#90796c}.rating{display:block;font-size:58rpx;font-weight:800;color:#802b22}.stats{display:flex;gap:20rpx;font-size:24rpx;color:#5e514a}.play{margin:26rpx 0;height:104rpx;line-height:104rpx;font-size:36rpx;font-weight:700}.difficulty{padding:28rpx;display:flex;justify-content:space-between;align-items:center}.difficulty-name{display:block;font-size:34rpx;font-weight:700;margin-top:6rpx}.rank{font-size:24rpx;color:#8d6750}.grid{display:grid;grid-template-columns:1fr 1fr;gap:20rpx;margin-top:24rpx}.entry{min-height:150rpx;padding:24rpx;display:flex;flex-direction:column;justify-content:center;position:relative}.icon{font-family:serif;font-size:38rpx;color:#8f3227;margin-bottom:10rpx}.badge{position:absolute;right:16rpx;top:16rpx;font-size:18rpx;background:#e8d6b6;color:#816b58;padding:4rpx 10rpx;border-radius:12rpx}.sync{display:block;text-align:center;font-size:21rpx;color:#958177;margin-top:34rpx}
