.profile {
  margin-top: var(--space-2);
}

/* 段位名比数字长得多(尤其英文 "Amateur 3 Dan"), 用相对字号 + 单行省略,
   免得中英文切换后某一侧被裁掉或换行 */
.rank {
  display: block;
  margin-top: var(--space-2);
  font-size: 56rpx;
  font-weight: bold;
  line-height: 1.2;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 三段占比一眼可见, 权重由页面按实际战绩设置 */
.winrate-bar {
  display: flex;
  height: 16rpx;
  margin-top: var(--space-4);
  border-radius: var(--radius-pill);
  overflow: hidden;
  background: var(--surface-sunken);
}

.seg { flex-basis: 0; }
.seg.win { background: var(--action); }
.seg.loss { background: var(--danger); }
.seg.draw { background: var(--text-tertiary); }

/* 图例, 颜色与上面的条一一对应 */
.legend {
  display: flex;
  margin-top: var(--space-2);
  font-size: var(--text-body-sm);
  font-weight: bold;
}
.legend-win { flex: 1; color: var(--action); }
.legend-loss { flex: 1; text-align: center; color: var(--danger); }
.legend-draw { flex: 1; text-align: right; color: var(--text-secondary); }

.games { margin-top: var(--space-1); }

.play {
  margin-top: var(--space-6);
  font-size: var(--text-title);
}
.play-text { margin-left: var(--space-2); }

.entry-live {
  display: flex;
  align-items: center;
  margin-top: var(--space-3);
}

.entry-live-body {
  flex: 1;
  min-width: 0;
  margin-left: var(--space-3);
}

.entry-live-title {
  display: flex;
  align-items: center;
}

/* 只在 App 端可用的入口带一枚小徽章 —— 点进去弹提示之前, 先让人看见 */
.app-badge {
  margin-left: var(--space-2);
  border: 1rpx solid var(--border-strong);
  border-radius: var(--radius-pill);
  padding: 0 var(--space-2);
  font-size: var(--text-caption);
  font-weight: normal;
  color: var(--text-tertiary);
}

.pair {
  display: flex;
  margin-top: var(--space-3);
}
.pair .btn {
  flex: 1;
  min-width: 0;
}
.pair .btn:first-child { margin-right: var(--space-2); }
.pair .btn:last-child { margin-left: var(--space-2); }
.pair-text { margin-left: var(--space-1); }

.low-row {
  display: flex;
  justify-content: center;
  margin-top: var(--space-6);
}
.low-row .btn {
  padding: 0 var(--space-3);
  min-width: 0;
}
.low-text { margin-left: var(--space-1); }
