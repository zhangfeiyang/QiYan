.page{padding:44rpx 32rpx 60rpx}.hero{display:flex;flex-direction:column;align-items:center;padding:30rpx 0 44rpx}.eyebrow{font-size:20rpx;letter-spacing:5rpx;color:#9b6b4d}.title{font-size:94rpx;font-family:serif;font-weight:900;color:#6f241d;line-height:1.2}.subtitle{font-size:26rpx;color:#765f50}.profile{padding:30rpx;display:flex;justify-content:space-between;align-items:end}.label{display:block;font-size:22rpx;color:#90796c}.rating{display:block;font-size:58rpx;font-weight:800;color:#802b22}.stats{display:flex;gap:20rpx;font-size:24rpx;color:#5e514a}.play{margin:26rpx 0;height:104rpx;line-height:104rpx;font-size:32rpx;font-weight:700}.levels{padding:24rpx 24rpx 28rpx;margin-top:6rpx}.levels-head{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:16rpx}.levels-head .label{font-size:22rpx;color:#7a6657}.levels-sub{font-size:18rpx;color:#a08c7a}.levels-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:12rpx}.level-tile{position:relative;padding:14rpx 6rpx 12rpx;border-radius:18rpx;background:rgba(255,255,255,.62);border:1rpx solid rgba(91,57,38,.12);display:flex;flex-direction:column;align-items:center;text-align:center}.level-tile.active{background:#7f2b23;color:#fff;border-color:#7f2b23;box-shadow:0 6rpx 18rpx rgba(127,43,35,.25)}.level-tile.active .level-rank,.level-tile.active .level-note{color:#f3e6ca}.level-tile.disabled{opacity:.4;background:rgba(231,219,197,.55)}.level-tile.disabled .level-note{color:#a08c7a}.level-num{font-size:22rpx;font-weight:700}.level-name{font-size:22rpx;font-weight:600;margin-top:4rpx}.level-rank{font-size:18rpx;color:#7a6657;margin-top:2rpx;line-height:1.2}.level-note{font-size:16rpx;color:#8d6750;margin-top:8rpx;line-height:1.25;min-height:36rpx;padding:0 2rpx}.level-tag{position:absolute;right:4rpx;top:4rpx;font-size:15rpx;background:#e8d6b6;color:#816b58;padding:2rpx 8rpx;border-radius:10rpx;line-height:1.2}.grid{display:grid;grid-template-columns:1fr 1fr;gap:20rpx;margin-top:24rpx}.entry{min-height:150rpx;padding:24rpx;display:flex;flex-direction:column;justify-content:center;position:relative}.icon{font-family:serif;font-size:38rpx;color:#8f3227;margin-bottom:10rpx}.badge{position:absolute;right:16rpx;top:16rpx;font-size:18rpx;background:#e8d6b6;color:#816b58;padding:4rpx 10rpx;border-radius:12rpx}.sync{display:block;text-align:center;font-size:21rpx;color:#958177;margin-top:34rpx}
