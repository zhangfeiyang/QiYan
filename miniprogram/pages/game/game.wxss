.page{padding:20rpx 20rpx 180rpx}.topbar{padding:18rpx 24rpx;margin-bottom:18rpx;display:flex;justify-content:space-between;align-items:center}.status{font-size:30rpx;font-weight:700;display:block}.level{font-size:20rpx;color:#806e63}.turn{width:60rpx;height:60rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;background:#8e3026;color:white;font-family:serif;font-size:32rpx}.app-only-hint{padding:22rpx 26rpx;margin-bottom:18rpx;background:rgba(127,43,35,.92);color:#f3e6ca}.app-only-title{display:block;font-size:28rpx;font-weight:800;margin-bottom:8rpx}.app-only-text{display:block;font-size:22rpx;line-height:1.5;color:#f1d9b6}.actions{position:fixed;z-index:6;left:20rpx;right:20rpx;bottom:calc(env(safe-area-inset-bottom) + 20rpx);display:grid;grid-template-columns:repeat(5,1fr);padding:12rpx;gap:8rpx}.actions button{font-size:22rpx;padding:0;height:68rpx;line-height:68rpx;background:#f8f0df;color:#503f35}.actions .analysis{background:#7f2b23;color:#fff}.scanner{position:fixed;z-index:20;inset:0;background:rgba(22,17,15,.66);display:flex;flex-direction:column;align-items:center;justify-content:center;color:white;font-size:36rpx;font-weight:700;overflow:hidden}.scan-line{position:absolute;left:5%;right:5%;height:5rpx;background:#e6bd64;box-shadow:0 0 30rpx #ffda79;animation:scan 1.25s ease-in-out infinite alternate}.scan-sub{font-size:22rpx;font-weight:400;margin-top:14rpx;color:#eadcce}@keyframes scan{from{top:15%}to{top:83%}}.analysis-panel{position:fixed;z-index:10;left:16rpx;right:16rpx;bottom:calc(env(safe-area-inset-bottom) + 102rpx);max-height:48vh;padding:20rpx;border-radius:28rpx;background:rgba(247,239,222,.82);backdrop-filter:blur(9px);border:1rpx solid rgba(91,57,38,.25);box-shadow:0 0 50rpx rgba(33,22,17,.25)}.panel-head{display:flex;justify-content:space-between;align-items:center}.panel-title{display:block;font-size:30rpx;font-weight:800}.panel-sub{display:block;font-size:20rpx;color:#76655b}.close{font-size:50rpx;line-height:1;padding:0 10rpx}.messages{height:220rpx;margin:14rpx 0}.message{max-width:82%;padding:14rpx 18rpx;margin:10rpx 0;border-radius:18rpx;font-size:24rpx;line-height:1.5;background:rgba(255,255,255,.58)}.message.user{margin-left:auto;background:rgba(137,48,37,.75);color:#fff}.prompt-row{display:flex;gap:10rpx;white-space:nowrap}.prompt{display:inline-block;background:rgba(255,255,255,.56);border:1rpx solid rgba(98,63,42,.2);border-radius:22rpx;padding:10rpx 16rpx;font-size:21rpx}.composer{display:flex;gap:10rpx;margin-top:12rpx}.composer input{flex:1;height:68rpx;background:rgba(255,255,255,.7);border-radius:16rpx;padding:0 18rpx;font-size:24rpx}.composer button{width:120rpx;height:68rpx;line-height:68rpx;padding:0;font-size:24rpx;background:#7f2b23;color:#fff}.composer button[disabled]{opacity:.45}
