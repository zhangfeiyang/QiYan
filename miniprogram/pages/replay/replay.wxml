<scroll-view class="screen {{themeClass}}" scroll-y>
  <view class="scroll-body">
    <view wx:if="{{!records.length}}" class="empty">
      <text class="t-secondary">{{T.replay_empty}}</text>
    </view>

    <view
      wx:for="{{records}}"
      wx:key="id"
      class="card record"
      data-id="{{item.id}}"
      bindtap="openRecord"
    >
      <view class="record-head">
        <text class="result {{item.resultClass}}">{{item.resultText}}</text>
        <text class="t-secondary">{{item.sideText}}</text>
        <text class="t-secondary level">{{item.levelText}}</text>
        <text class="t-label date">{{item.dateText}}</text>
      </view>
      <view class="record-foot">
        <text class="t-secondary">{{item.summary}}</text>
        <text class="t-label">{{item.ratingText}}</text>
      </view>
    </view>
  </view>
</scroll-view>
