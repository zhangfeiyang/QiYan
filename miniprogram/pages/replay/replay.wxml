<view class="page"><view class="summary card"><text>{{status}}</text><text class="muted">第 {{index}} / {{moves.length}} 步</text></view><xiangqi-board board="{{board}}" flipped="{{flipped}}" disabled="{{true}}"/><view class="controls card"><button bindtap="previous">上一步</button><button bindtap="flip">翻转</button><button bindtap="next">下一步</button></view><scroll-view class="moves card" scroll-y><text wx:if="{{!moves.length}}" class="muted">完成一局后可在这里逐步复盘。</text><view wx:for="{{moves}}" wx:key="moveIndex" class="move {{index===moveIndex+1?'active':''}}" wx:for-index="moveIndex">{{moveIndex+1}}. {{item}}</view></scroll-view></view>
