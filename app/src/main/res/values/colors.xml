<?xml version="1.0" encoding="utf-8"?>
<!--
  亮色主题 (values/).

  暗色是本 App 的主设计, 见 values-night/colors.xml —— 这里是选择"浅色"
  的用户拿到的那一套. 两边**必须**保持同名 token, 缺一个就会在切主题时
  崩成未解析资源.

  命名按语义而非外观: surface_raised 而不是 bg_card, 这样棋谱卡片和对话
  气泡共用一个 token 时不必解释"为什么卡片色叫 card 却用在气泡上".
-->
<resources>

    <!-- ============ 表面层次 ============ -->
    <!-- 由低到高: sunken 内凹 < base 底 < raised 卡片 < overlay 浮层 -->
    <color name="surface_sunken">#E6E2DB</color>
    <color name="surface_base">#F4F2EE</color>
    <color name="surface_raised">#FFFFFF</color>
    <color name="surface_overlay">#FFFFFF</color>

    <!-- ============ 描边 ============ -->
    <color name="border_subtle">#DEDAD3</color>
    <color name="border_strong">#C4BFB7</color>

    <!-- ============ 文字 ============ -->
    <color name="text_primary">#23211F</color>
    <color name="text_secondary">#5E5952</color>
    <color name="text_tertiary">#8E8880</color>
    <color name="text_on_action">#FFFFFF</color>

    <!-- ============ 行动色 ============ -->
    <!-- #55802D 而非暗色那支 #81B64C: 白字压在浅绿上对比度不够 (约 4.1:1),
         压深到 4.6:1 才过 WCAG AA 正文线. -->
    <color name="action">#55802D</color>
    <color name="action_pressed">#446725</color>
    <color name="action_muted">#EAF1E0</color>

    <!-- ============ 语义色 ============ -->
    <color name="danger">#C4362B</color>
    <color name="warning">#B77A16</color>
    <color name="info">#2F6FAF</color>
    <!-- 淡底变体: 报错气泡/提示条要有自己的底色, 否则"错误"和普通内容
         同色, 用户根本读不出这是一条失败信息. -->
    <color name="danger_muted">#FBEAE8</color>

    <!-- ============ 对弈双方 (UI 文字/标签用) ============ -->
    <!-- 注意与 piece_* 区分: 那是画在木色棋盘上的棋子, 这是画在界面表面上
         的文字. 同一个"黑方"在浅色界面上是深色, 在暗色界面上必须是浅色. -->
    <color name="side_red">#C0392B</color>
    <color name="side_black">#2C2A28</color>

    <!-- ============ 棋盘 ============ -->
    <!-- grad_* 是木纹渐变的四个停靠点, 从左上到右下由浅到深 -->
    <color name="board_grad_1">#EBD9B4</color>
    <color name="board_grad_2">#DDC49A</color>
    <color name="board_grad_3">#D2B288</color>
    <color name="board_grad_4">#C0A272</color>
    <color name="board_line">#4A3826</color>
    <color name="board_palace">#6B4A2A</color>
    <color name="board_border">#8A6E48</color>
    <color name="board_coord">#7A5D3A</color>
    <color name="board_grain">#80A0826D</color>

    <!-- ============ 棋子 ============ -->
    <!-- 棋子面色. 摆子托盘里的棋子也用它, 与盘上的子看起来是同一副 -->
    <color name="piece_face">#F5E9CE</color>
    <color name="piece_red">#B4302A</color>
    <color name="piece_red_edge">#7C1A16</color>
    <color name="piece_black">#22201E</color>
    <!-- 棋子面的径向高光: 左上亮 → 右下暗, 做出圆润的立体感 -->
    <color name="piece_grad_1">#FFF8DC</color>
    <color name="piece_grad_2">#F2E2BF</color>
    <color name="piece_grad_3">#DEC69B</color>
    <color name="piece_grain">#30A0826D</color>
    <color name="piece_shadow">#40000000</color>

    <!-- ============ 落子高亮 (画在木色上, 需带 alpha) ============ -->
    <color name="hl_select">#99F2C94C</color>
    <color name="hl_move">#995FA83E</color>
    <color name="hl_capture">#99D64541</color>
    <color name="hl_last">#80E3A13C</color>
    <color name="hl_hint">#995B9DD9</color>
    <color name="hl_check">#99E0574A</color>
    <!-- 选中环: 压在棋子之上, 所以不带 alpha -->
    <!-- 吃子特效的火星色: 红黑双方共用, 靠亮度从棋子本色里跳出来 -->
    <color name="fx_spark">#FFB020</color>
    <color name="sel_ring">#F2A03C</color>
    <!-- 可走点的外圈光晕, 比实心点更淡 -->
    <color name="hl_move_halo">#4D5FA83E</color>
    <!-- 提示的次选点 -->
    <color name="hl_hint_soft">#665B9DD9</color>
    <!-- 提示箭头是不透明的: 它压在棋子上, 半透明会和棋子颜色混成脏色 -->
    <color name="hl_arrow">#2E7D32</color>

    <!-- ============ 胜率条 ============ -->
    <!-- soft→strong 是各自那半区的渐变两端, 优势越大越往 strong 走 -->
    <color name="winrate_red_soft">#E08B84</color>
    <color name="winrate_red_strong">#C0392B</color>
    <color name="winrate_black_soft">#6E6A66</color>
    <color name="winrate_black_strong">#2C2A28</color>
    <!-- 百分比文字压在各自半区上, 所以要分开定: 亮色主题两半都是深色底,
         白字都能读; 暗色主题黑方那半是浅色, 见 values-night. -->
    <color name="winrate_text_on_red">#FFFFFF</color>
    <color name="winrate_text_on_black">#FFFFFF</color>

    <!-- ============ 段位 ============ -->
    <color name="rank_bronze">#B06D33</color>
    <color name="rank_silver">#8C8C94</color>
    <color name="rank_gold">#C79A1E</color>
    <color name="rank_platinum">#6E8A96</color>
    <color name="rank_diamond">#2E9BB8</color>
    <color name="rank_master">#E2551F</color>
    <color name="rank_grandmaster">#8E4EC6</color>
    <color name="rank_king">#C79A1E</color>

</resources>
