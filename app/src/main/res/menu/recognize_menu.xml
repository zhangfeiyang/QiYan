<?xml version="1.0" encoding="utf-8"?>
<!--
  两条取图路径都放在 toolbar 上常驻显示 —— 识别完之后还要能换一张。

  首次取图不靠这里: 进来先是一屏引导, 两条路并列摆着(见 activity_recognize
  的 start_panel)。toolbar 上这两个是"再来一张"用的。

  「实时支招」原来也挂在这里, 已移到首页独立入口 —— 它和"拍照识局"是两件事,
  挂在这个 toolbar 下会让人以为它是识局的一个子功能。
-->
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <item
        android:id="@+id/action_gallery"
        android:icon="@drawable/ic_image"
        android:title="@string/recognize_pick_image"
        app:showAsAction="always" />
    <item
        android:id="@+id/action_retake"
        android:icon="@drawable/ic_camera"
        android:title="@string/recognize_take_photo"
        app:showAsAction="always" />
</menu>
