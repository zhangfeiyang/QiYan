<?xml version="1.0" encoding="utf-8"?>
<!--
  暗色主题 —— 浅色那套的夜间对应 (主设计见 values/colors.xml).

  中性色带一点暖褐 (#22201D 而非 #242424): 纯灰配木色棋盘会显脏, 让底色和
  棋盘落在同一个色温上, 木头才像是"放在桌上"而不是"贴在屏幕上".

  棋盘和棋子的处理与浅色一致 —— 实心色底 + 白字。深底上木盘要**压暗**而不
  是提亮: 满屏原木在近黑底上会过曝, 反过来抢走棋子的注意力。
-->
<resources>

    <!-- ============ 表面层次 ============ -->
    <color name="surface_sunken">#1A1917</color>
    <color name="surface_base">#22201D</color>
    <color name="surface_raised">#2C2A26</color>
    <color name="surface_overlay">#37342F</color>

    <!-- ============ 描边 ============ -->
    <color name="border_subtle">#3A3630</color>
    <color name="border_strong">#544E46</color>

    <!-- ============ 文字 ============ -->
    <!-- 不用纯白: #FFFFFF 压在深底上会晕开 (halation), 长时间看棋很累. -->
    <color name="text_primary">#F0ECE5</color>
    <color name="text_secondary">#AFA89E</color>
    <color name="text_tertiary">#7C766D</color>
    <color name="text_on_action">#FFFFFF</color>

    <!-- ============ 品牌 / 主行动 ============ -->
    <!-- 朱红在深底上要提亮一档, 否则填充键看起来像一块干掉的血渍.
         白字压 #D6453A 3.9:1 —— 按钮文字是粗体大字, 走 AA Large 这条线. -->
    <color name="action">#D6453A</color>
    <color name="action_pressed">#B8352C</color>
    <color name="action_muted">#3A2320</color>

    <!-- ============ 对局内的正向色 ============ -->
    <color name="affirm">#81B64C</color>
    <color name="affirm_muted">#2C3821</color>

    <!-- ============ 语义色 ============ -->
    <!-- 浅色下 danger 比 action 更**深**, 暗色下必须反过来更**暗淡**:
         深底上"更深"等于消失, 所以这里靠降低饱和度来和 action 拉开. -->
    <color name="danger">#E07068</color>
    <color name="warning">#E3A13C</color>
    <color name="info">#5B9DD9</color>
    <color name="danger_muted">#3A2320</color>

    <!-- ============ 对弈双方 (UI 文字/标签用) ============ -->
    <!-- side_black 在暗色下是**浅**色. 把 #2C2C2C 当"黑方"文字色压在深底上
         等于隐形 —— 主菜单那行"负 0"就是这么消失的. -->
    <color name="side_red">#E8635C</color>
    <color name="side_black">#CFC9C1</color>

    <!-- ============ 棋盘 ============ -->
    <color name="board_grad_1">#C6AC80</color>
    <color name="board_grad_2">#BCA073</color>
    <color name="board_grad_3">#B09468</color>
    <color name="board_grad_4">#9E835A</color>
    <color name="board_line">#6E4A24</color>
    <color name="board_palace">#5A3A1B</color>
    <!-- 外框在暗色下反而要更深: 让棋盘从背景里"浮"出来 -->
    <color name="board_border">#16130F</color>
    <color name="board_coord">#8A6C42</color>
    <color name="board_grain">#40806040</color>

    <!-- ============ 棋子 ============ -->
    <!-- 与浅色同构: 实心色底 + 白字. 红子在暗木上略提亮以保住边界. -->
    <color name="piece_red">#C43A2C</color>
    <color name="piece_red_edge">#8E2A20</color>
    <color name="piece_black">#1C1A18</color>
    <color name="piece_black_edge">#000000</color>
    <color name="piece_text">#FFFFFF</color>
    <color name="piece_face">#F0E2C4</color>
    <color name="piece_grad_1">#30FFFFFF</color>
    <color name="piece_grad_2">#12FFFFFF</color>
    <color name="piece_grad_3">#00FFFFFF</color>
    <color name="piece_grain">#14FFFFFF</color>
    <!-- 暗色下阴影加重: 棋子落在木盘上要有明确的离地感 -->
    <color name="piece_shadow">#59000000</color>

    <!-- ============ 落子高亮 ============ -->
    <color name="hl_select">#99F2C94C</color>
    <color name="hl_move">#9981B64C</color>
    <color name="hl_capture">#99D64541</color>
    <color name="hl_last">#66E3A13C</color>
    <color name="hl_hint">#995B9DD9</color>
    <color name="hl_check">#99E0574A</color>
    <color name="fx_spark">#FFD24A</color>
    <color name="sel_ring">#FFC24D</color>
    <color name="hl_move_halo">#4081B64C</color>
    <color name="hl_hint_soft">#555B9DD9</color>
    <color name="hl_arrow">#81B64C</color>

    <!-- ============ 胜率条 ============ -->
    <!-- 黑方那一半必须提亮, 否则在深底上看不出条子占了多少. -->
    <color name="winrate_red_soft">#E8918A</color>
    <color name="winrate_red_strong">#D6483F</color>
    <color name="winrate_black_soft">#B8B2AA</color>
    <color name="winrate_black_strong">#E8E4DE</color>
    <color name="winrate_text_on_red">#FFFFFF</color>
    <!-- 黑方半区是浅色, 白字会糊掉, 必须换成深色 -->
    <color name="winrate_text_on_black">#22201D</color>

    <!-- ============ 引擎加载遮罩 ============ -->
    <!-- 与浅色版同构: 暗底上米白会"过曝", 用深底的 surface_base 加
         alpha 才有"压住棋盘等引擎起来"的层次感。 -->
    <color name="loading_scrim">#B322201D</color>

    <!-- ============ 段位 ============ -->
    <color name="rank_bronze">#C87F3F</color>
    <color name="rank_silver">#BFBFC4</color>
    <color name="rank_gold">#E8C04A</color>
    <color name="rank_platinum">#D8E0E4</color>
    <color name="rank_diamond">#7FD9EF</color>
    <color name="rank_master">#FF7043</color>
    <color name="rank_grandmaster">#B57BE0</color>
    <!-- 见浅色那份的说明: 棋王用玉色, 不与 rank_gold 重复 -->
    <color name="rank_king">#4FD6BE</color>

</resources>
