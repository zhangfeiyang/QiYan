<?xml version="1.0" encoding="utf-8"?>
<!--
  AI 回复气泡: 透明覆盖对话框背景, 看到下面的棋局.

  之前用 surface_raised (#FFFFFF) 是不透明白底, 一旦有回复就把棋局完全
  盖住. 改为 70% 不透明的浅底, 文字仍能清楚读到 (深色文字压在 70% 浅色
  上对比度足够), 但底下的棋盘能透过来.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#B3FFFFFF" />
    <stroke android:width="1dp" android:color="#66FFFFFF" />
    <corners
        android:topLeftRadius="@dimen/radius_lg"
        android:topRightRadius="@dimen/radius_lg"
        android:bottomLeftRadius="@dimen/radius_sm"
        android:bottomRightRadius="@dimen/radius_lg" />
</shape>
