<?xml version="1.0" encoding="utf-8"?>
<!--
  用户消息气泡: 行动色 + 75% 不透明, 保留品牌色相但让底色透出来.

  实底完全把棋局盖住, 75% 还是会让棋盘隐约可见; 对话过程中用户能持续
  看到上面那行扫描屏/棋盘的轮廓.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#BF55802D" />
    <corners
        android:topLeftRadius="@dimen/radius_lg"
        android:topRightRadius="@dimen/radius_lg"
        android:bottomLeftRadius="@dimen/radius_lg"
        android:bottomRightRadius="@dimen/radius_sm" />
</shape>
