<?xml version="1.0" encoding="utf-8"?>
<!-- JJ象棋风格 胜利匾额: 辉煌赤金金边，深红渐变底，庄重古雅气派 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 外层发光金边 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#FFF8E1"
                android:centerColor="#FFD54F"
                android:endColor="#FF8F00" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <!-- 中层朱红垫层 -->
    <item
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#3E0000" />
            <corners android:radius="15dp" />
        </shape>
    </item>
    <!-- 内层朱红渐变主屏 -->
    <item
        android:bottom="5dp"
        android:left="5dp"
        android:right="5dp"
        android:top="5dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#7F0000"
                android:centerColor="#B71C1C"
                android:endColor="#D32F2F" />
            <stroke
                android:width="1.5dp"
                android:color="#FFE082" />
            <corners android:radius="13dp" />
        </shape>
    </item>
</layer-list>
