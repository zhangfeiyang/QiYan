<?xml version="1.0" encoding="utf-8"?>
<!--
  杀法徽记: 一枚红方棋子 (象牙面 + 朱砂刻环), 与盘上棋子、对手头像同一套画法.
  杀法宝典里以前放的是 emoji, 这里换成这一杀法的主子.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/piece_face" />
            <stroke android:width="1dp" android:color="#33000000" />
        </shape>
    </item>
    <item
        android:left="3dp"
        android:top="3dp"
        android:right="3dp"
        android:bottom="3dp">
        <shape android:shape="oval">
            <stroke android:width="1.5dp" android:color="@color/piece_red" />
        </shape>
    </item>
</layer-list>
