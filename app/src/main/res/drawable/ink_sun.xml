<?xml version="1.0" encoding="utf-8"?>
<!--
  淡朱红日(首页点睛).

  参考设计的首页右上有一轮将沉的红日, 是整个浅米页面里唯一的暖色圆.
  矢量做不了羽化边, 用"一枚淡环 + 一枚略浓的芯"两层同心圆模拟
  晕开的边缘, 浓淡都烘在 ink_sun 的 alpha 里.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="72dp"
    android:height="72dp"
    android:viewportWidth="72"
    android:viewportHeight="72">

    <!-- 外圈: 晕开的边 -->
    <path
        android:fillColor="@color/ink_sun"
        android:pathData="M36,36 m-32,0 a32,32 0 1 1 64,0 a32,32 0 1 1 -64,0" />

    <!-- 日芯: 收一档, 靠叠色比外圈浓 -->
    <path
        android:fillColor="@color/ink_sun"
        android:pathData="M36,36 m-24,0 a24,24 0 1 1 48,0 a24,24 0 1 1 -48,0" />

</vector>
