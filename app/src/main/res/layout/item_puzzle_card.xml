<?xml version="1.0" encoding="utf-8"?>
<!-- 残局精美卡片: 编号 + 关卡名称 + 目标步数 + 通关状态印章 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_puzzle_card"
    android:clickable="true"
    android:focusable="true"
    android:padding="12dp">

    <!-- 顶部行: 关卡编号 + 通关印章/状态 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/puzzle_no"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_action"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:textColor="@color/action"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="第 1 关" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/puzzle_seal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_puzzle_seal"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="@string/puzzle_solved"
            android:textColor="@color/action"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/puzzle_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_tertiary"
            android:textSize="11sp"
            tools:text="待破解" />
    </LinearLayout>

    <!-- 中间: 关卡名称 -->
    <TextView
        android:id="@+id/puzzle_name"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:textStyle="bold"
        android:fontFamily="serif"
        android:layout_marginTop="4dp"
        tools:text="一步杀·困毙" />

    <!-- 底部: 目标步数与提示标签 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/puzzle_goal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            tools:text="红先 · 1步绝杀" />
    </LinearLayout>

</LinearLayout>
