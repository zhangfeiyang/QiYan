<?xml version="1.0" encoding="utf-8"?>
<!--
  实时支招. 画面就是相机预览本身, 箭头直接叠在上面 ——
  用户举着手机对着棋盘, 眼睛不用在"屏幕上的棋盘"和"真实棋盘"之间来回找对应.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:scaleType="fillCenter"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.zhongguoxiangqi.ui.live.BoardOverlayView
        android:id="@+id/overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@id/preview"
        app:layout_constraintBottom_toBottomOf="@id/preview"
        app:layout_constraintStart_toStartOf="@id/preview"
        app:layout_constraintEnd_toEndOf="@id/preview" />

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#66000000"
        app:title="@string/live_title"
        app:titleTextColor="#FFFFFF"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 走子方: 同一个局面轮谁走, 最佳着法完全不同, 这个必须让用户指定 -->
    <RadioGroup
        android:id="@+id/side_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#66000000"
        android:paddingHorizontal="@dimen/space_3"
        android:layout_marginBottom="@dimen/space_2"
        app:layout_constraintBottom_toTopOf="@id/status"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <RadioButton
            android:id="@+id/side_red"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_min"
            android:checked="true"
            android:textColor="#FFFFFF"
            android:text="@string/recognize_red_to_move" />

        <RadioButton
            android:id="@+id/side_black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_3"
            android:minHeight="@dimen/touch_min"
            android:textColor="#FFFFFF"
            android:text="@string/recognize_black_to_move" />

    </RadioGroup>

    <TextView
        android:id="@+id/status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#66000000"
        android:gravity="center"
        android:paddingVertical="@dimen/space_3"
        android:textColor="#FFFFFF"
        android:textSize="@dimen/text_body_sm"
        android:text="@string/live_locking"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="已锁定 · 识别 180ms" />

    <!-- 当前缩放倍率, 仅放大时显示; 双击预览可重置回 1x -->
    <TextView
        android:id="@+id/zoom_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#66000000"
        android:paddingHorizontal="@dimen/space_2"
        android:paddingVertical="@dimen/space_1"
        android:textColor="#FFFFFF"
        android:textSize="@dimen/text_body_sm"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/space_2"
        android:layout_marginEnd="@dimen/space_2"
        tools:text="2.0x" />

</androidx.constraintlayout.widget.ConstraintLayout>
