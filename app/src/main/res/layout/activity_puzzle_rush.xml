<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_page">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/puzzle_rush_title"
        app:titleTextColor="@color/text_primary"
        app:navigationIcon="@drawable/ic_close"
        app:navigationIconTint="@color/text_primary" />

    <!-- 极速状态仪表盘 (得分/连击 · 倒计时 · 生命值) -->
    <LinearLayout
        android:id="@+id/rush_hud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:background="@color/surface_raised">

        <!-- 左侧: 累计得分与连击 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/rush_score_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/action"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                tools:text="得分 0" />

            <TextView
                android:id="@+id/rush_combo_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FF9800"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="🔥 连击 x3" />
        </LinearLayout>

        <!-- 中间: 倒计时器 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:background="@drawable/bg_opponent_avatar">

            <TextView
                android:id="@+id/rush_timer_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                tools:text="03:00" />
        </LinearLayout>

        <!-- 右侧: 3颗生命心形 -->
        <LinearLayout
            android:id="@+id/lives_container"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/rush_lives_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:text="❤️❤️❤️" />
        </LinearLayout>

    </LinearLayout>

    <!-- 题目提示条 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/puzzle_prompt"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            tools:text="红先 · 一步必杀" />

        <TextView
            android:id="@+id/rush_best_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/lounge_soft_gold"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="🏆 最高: 15" />
    </LinearLayout>

    <!-- 棋盘容器与闪烁特效 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="8dp">

        <com.zhongguoxiangqi.ui.board.BoardView
            android:id="@+id/board_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 答对/答错反馈动画遮罩 -->
        <View
            android:id="@+id/feedback_flash"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#00000000"
            android:visibility="gone" />

        <!-- 连击浮动大文字 -->
        <TextView
            android:id="@+id/combo_popup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="#FFD700"
            android:textSize="32sp"
            android:textStyle="bold"
            android:shadowColor="#80000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="6"
            android:visibility="gone"
            tools:text="+1 妙招！" />
    </FrameLayout>

    <!-- 底部控制栏 -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_skip"
            style="@style/Widget.Xiangqi.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/puzzle_rush_pass"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

    </LinearLayout>

</LinearLayout>
