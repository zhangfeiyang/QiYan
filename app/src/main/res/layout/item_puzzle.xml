<?xml version="1.0" encoding="utf-8"?>
<!-- 残局条目: 关号徽标 + 名称 + 目标 + 状态 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground"
    android:paddingHorizontal="@dimen/screen_gutter"
    android:paddingVertical="@dimen/space_3">

    <TextView
        android:id="@+id/puzzle_no"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="32dp"
        android:gravity="center"
        android:background="@drawable/bg_pill_action"
        android:paddingHorizontal="@dimen/space_2"
        android:paddingVertical="@dimen/space_1"
        android:textColor="@color/action"
        android:textSize="@dimen/text_caption"
        android:textStyle="bold"
        tools:text="第 1 关" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_3"
        android:orientation="vertical">

        <TextView
            android:id="@+id/puzzle_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAppearance="@style/TextAppearance.Xiangqi.Title"
            tools:text="一步杀·困毙" />

        <TextView
            android:id="@+id/puzzle_goal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.Xiangqi.Secondary"
            tools:text="红先, 1 步内将死黑方" />

    </LinearLayout>

    <TextView
        android:id="@+id/puzzle_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_2"
        android:textSize="@dimen/text_caption"
        android:textStyle="bold"
        tools:text="已破解" />

</LinearLayout>
