<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        app:title="@string/title_settings"
        app:titleTextColor="#FFFFFF"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:navigationIconTint="#FFFFFF" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/margin_medium">

            <!-- 引擎设置 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small"
                android:text="@string/settings_engine"
                android:textColor="@color/accent"
                android:textSize="@dimen/text_title"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small"
                android:orientation="vertical"
                android:background="@color/bg_card"
                android:padding="@dimen/margin_medium">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_threads"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_medium" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <SeekBar
                        android:id="@+id/seek_threads"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:max="8"
                        android:progress="2" />

                    <TextView
                        android:id="@+id/tv_threads_value"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="2"
                        android:textColor="@color/accent"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_small"
                    android:text="@string/settings_hash"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_medium" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <SeekBar
                        android:id="@+id/seek_hash"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:max="1024"
                        android:progress="64" />

                    <TextView
                        android:id="@+id/tv_hash_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:minWidth="80dp"
                        android:text="64 MB"
                        android:textColor="@color/accent"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <!-- 界面设置 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_large"
                android:text="界面设置"
                android:textColor="@color/accent"
                android:textSize="@dimen/text_title"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small"
                android:orientation="vertical"
                android:background="@color/bg_card"
                android:padding="@dimen/margin_medium">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/sw_sound"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_sound"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_medium" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/sw_vibrate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_vibrate"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_medium" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/sw_show_coords"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_show_coords"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_medium" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/sw_show_winrate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_show_winrate"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_medium" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/sw_animation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_animation"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_medium" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/sw_flipped"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_board_flip"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_medium" />

            </LinearLayout>

            <!-- 主题设置 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_large"
                android:text="@string/settings_theme"
                android:textColor="@color/accent"
                android:textSize="@dimen/text_title"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/theme_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small"
                android:background="@color/bg_card"
                android:padding="@dimen/margin_medium"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/theme_system"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="跟随系统"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_medium"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/theme_light"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="浅色"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_medium" />

                <RadioButton
                    android:id="@+id/theme_dark"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="深色"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_medium" />

            </RadioGroup>

            <!-- 关于 & 数据 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_large"
                android:text="其他"
                android:textColor="@color/accent"
                android:textSize="@dimen/text_title"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_about"
                style="@style/Widget.ZhongguoXiangqi.Button.Outline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_small"
                android:text="@string/menu_about" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_clear_data"
                style="@style/Widget.ZhongguoXiangqi.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="清除所有数据"
                android:textColor="@color/status_red" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>