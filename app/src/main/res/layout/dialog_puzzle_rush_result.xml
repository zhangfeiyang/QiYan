<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_result_dialog"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/result_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/puzzle_rush_result_title"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:fontFamily="serif" />

    <TextView
        android:id="@+id/result_reason"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="4dp"
        tools:text="时间耗尽" />

    <!-- 核心得分数字 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:layout_marginTop="16dp">

        <TextView
            android:id="@+id/result_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="52sp"
            android:textStyle="bold"
            android:textColor="@color/lounge_soft_gold"
            android:fontFamily="serif"
            tools:text="12" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/puzzle_rush_score_unit"
            android:textSize="20sp"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="8dp" />
    </LinearLayout>

    <!-- 荣誉称号勋章 -->
    <TextView
        android:id="@+id/result_honor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="4dp"
        android:background="@drawable/bg_opponent_avatar"
        android:textColor="@color/affirm"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="🏆 疾风快刀" />

    <!-- 历史最佳纪录提示 -->
    <TextView
        android:id="@+id/result_high_score_note"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        tools:text="历史最高纪录: 15 局" />

    <!-- 按钮操作区 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="22dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_retry"
            style="@style/Widget.Xiangqi.Button.Gold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/puzzle_rush_play_again"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_share"
                style="@style/Widget.Xiangqi.Button.Outlined"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/puzzle_rush_share"
                android:textSize="13sp" />

            <View
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_exit"
                style="@style/Widget.Xiangqi.Button.Outlined"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/dialog_cancel"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
