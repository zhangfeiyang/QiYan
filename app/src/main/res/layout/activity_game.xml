<?xml version="1.0" encoding="utf-8"?>
<!--
  对弈.

  旧版底部是 5 个一模一样的描边按钮 (提示/悔棋/翻转/认输 + 独占一行的
  AI分析). 问题有两个:
    · 认输是不可逆操作, 却和"提示"长得完全一样, 只隔了 4dp
    · 5 个按钮里 4 个挤在一行, 字号被压到 12sp 才塞得下, 且全是纯文字
  现在改成图标在上、文字在下的工具键排成一行, 认输单独用危险色描边分出来;
  AI 分析并入同一行, 省下的一整行高度还给棋盘.

  对局双方那两行原来只靠一条 4dp 色条区分; 现在执子色做成圆点, 并且由
  GameActivity 按当前走子方调整两行的 alpha —— 轮到谁走谁就亮起来.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_page"
    android:orientation="vertical"
    tools:context=".ui.game.GameActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:titleTextColor="@color/text_primary"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="@color/text_primary" />

    <!-- ============ 对手 ============ -->
    <!-- 固定高度: 里面的"思考中"胶囊比同行文字高, 用 wrap_content 会让这行
         随它出现/消失而变高变矮, 进而挤压下面 weight=1 的棋盘. -->
    <!-- 整行可点: 点开改 AI 等级. 对局中随时能改, 所以入口要一直在手边,
         而不是藏在设置里或只能开局前选. -->
    <LinearLayout
        android:id="@+id/opponent_row"
        android:layout_width="match_parent"
        android:layout_height="@dimen/info_row_height"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/screen_gutter"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <!-- 执子圆点. 颜色由 Activity 按当前执子方设置 —— 「翻转」会换边,
             写死在 XML 里换完就反了. -->
        <View
            android:id="@+id/opponent_dot"
            android:layout_width="@dimen/space_3"
            android:layout_height="@dimen/space_3"
            android:layout_marginEnd="@dimen/space_3"
            android:background="@drawable/dot_side_black" />

        <TextView
            android:id="@+id/opponent_name"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body"
            android:textStyle="bold"
            tools:text="引擎" />

        <TextView
            android:id="@+id/level_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_2"
            android:background="@drawable/bg_pill_action"
            android:paddingStart="@dimen/space_3"
            android:paddingEnd="@dimen/space_2"
            android:paddingVertical="@dimen/space_1"
            android:drawablePadding="2dp"
            app:drawableEndCompat="@drawable/ic_chevron_down"
            app:drawableTint="@color/text_tertiary"
            android:textColor="@color/action"
            android:textSize="@dimen/text_caption"
            android:textStyle="bold"
            tools:text="Lv.3 中级" />

        <!-- 风格胶囊: 档位说"多强", 风格说"什么棋路"(攻杀/稳健/灵动).
             同一行可点入口的一部分, 点开在难度弹窗里切换. -->
        <TextView
            android:id="@+id/style_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_2"
            android:background="@drawable/bg_pill"
            android:paddingHorizontal="@dimen/space_3"
            android:paddingVertical="@dimen/space_1"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_caption"
            android:textStyle="bold"
            tools:text="攻杀型" />

        <TextView
            android:id="@+id/think_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_2"
            android:background="@drawable/bg_pill"
            android:paddingHorizontal="@dimen/space_3"
            android:paddingVertical="@dimen/space_1"
            android:text="@string/status_thinking"
            android:textColor="@color/warning"
            android:textSize="@dimen/text_caption"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>

    <!-- 48dp 太高: 字号是按条高的比例算的, 结果 "50.0%" 有 26sp, 比棋盘上
         的棋子还抢眼. 胜率是参考信息, 不该压过主体. -->
    <com.zhongguoxiangqi.ui.board.WinRateBarView
        android:id="@+id/winrate_bar"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginHorizontal="@dimen/screen_gutter" />

    <!-- 棋盘和提示条放进同一个 weight=1 的容器, 提示条**浮在**棋盘上而不是
         挤在它下面: 按"提示"时棋盘尺寸不能变, 否则又是一次跳动.
         棋盘按 9:10 居中留边, 底部本就有空隙, 提示条正好落在那儿. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.zhongguoxiangqi.ui.board.BoardView
            android:id="@+id/board_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/space_2" />

        <!-- 引擎准备中的遮罩.
             clickable=true 是关键: 这层要**吃掉**触摸事件, 否则棋盘在下面
             照常响应, 玩家可以走子, 而引擎还没起来不会回招. -->
        <LinearLayout
            android:id="@+id/engine_loading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@color/loading_scrim"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            tools:visibility="visible">

            <ProgressBar
                android:layout_width="@dimen/icon_lg"
                android:layout_height="@dimen/icon_lg"
                android:indeterminateTint="@color/action" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:text="@string/loading_engine"
                android:textAppearance="@style/TextAppearance.Xiangqi.Body" />

        </LinearLayout>

    </FrameLayout>

    <!-- ============ 我方 ============ -->
    <LinearLayout
        android:id="@+id/player_row"
        android:layout_width="match_parent"
        android:layout_height="@dimen/info_row_height"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/screen_gutter"
        android:gravity="center_vertical">

        <View
            android:id="@+id/player_dot"
            android:layout_width="@dimen/space_3"
            android:layout_height="@dimen/space_3"
            android:layout_marginEnd="@dimen/space_3"
            android:background="@drawable/dot_side_red" />

        <TextView
            android:id="@+id/player_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body"
            android:textStyle="bold"
            tools:text="我" />

        <TextView
            android:id="@+id/opening_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_2"
            android:background="@drawable/bg_pill_translucent"
            android:paddingHorizontal="@dimen/space_2"
            android:paddingVertical="2dp"
            android:textColor="@color/action"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible"
            tools:text="中炮对屏风马" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/player_rating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_caption"
            tools:text="1500" />

        <TextView
            android:id="@+id/move_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_3"
            android:textColor="@color/text_tertiary"
            android:textSize="@dimen/text_caption"
            tools:text="第 12 手" />

    </LinearLayout>

    <!-- ============ 工具条 ============ -->
    <!-- 一行五个图标键. 认输放最右且用危险色, 与其余四个拉开距离和色相,
         避免"想点翻转结果认输了"这类误触.
         paddingBottom 由 Activity 注入导航栏高度, 这里给的 baseBottomPad
         留出额外的呼吸空间, 让按钮整体上抬, 不贴住系统三键. -->
    <LinearLayout
        android:id="@+id/toolbar_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_2"
        android:paddingTop="@dimen/space_2"
        android:paddingBottom="@dimen/space_4"
        android:baselineAligned="false">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_hint"
            style="@style/Widget.Xiangqi.Button.Tool"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/action_hint"
            app:icon="@drawable/ic_hint" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_undo"
            style="@style/Widget.Xiangqi.Button.Tool"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/action_undo"
            app:icon="@drawable/ic_undo" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_flip"
            style="@style/Widget.Xiangqi.Button.Tool"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/action_flip"
            app:icon="@drawable/ic_flip" />

        <!-- AI 分析用行动色描出来: 它是这个 App 的差异化功能, 值得比
             普通工具键更显眼一档, 但仍不该抢走棋盘的注意力 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_ai"
            style="@style/Widget.Xiangqi.Button.Tool"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/advisor_button"
            android:textColor="@color/affirm"
            app:icon="@drawable/ic_ai"
            app:iconTint="@color/affirm" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_resign"
            style="@style/Widget.Xiangqi.Button.Tool"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/action_resign"
            android:textColor="@color/danger"
            app:icon="@drawable/ic_flag"
            app:iconTint="@color/danger" />

    </LinearLayout>
</LinearLayout>
