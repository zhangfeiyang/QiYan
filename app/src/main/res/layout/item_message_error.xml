<?xml version="1.0" encoding="utf-8"?>
<!--
  报错. 旧版是白字压深褐底, 居中显示 —— 看上去像一条系统公告, 而不是
  "你刚才那次请求失败了". 改成跟 AI 回复同侧靠左 + 危险色描边淡底 +
  警示图标, 让它明确归属于"上一条提问的结果".
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="start"
    android:paddingVertical="@dimen/space_1">

    <TextView
        android:id="@+id/text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="320dp"
        android:background="@drawable/bg_msg_error"
        android:paddingHorizontal="@dimen/space_4"
        android:paddingVertical="@dimen/space_3"
        android:drawablePadding="@dimen/space_2"
        app:drawableStartCompat="@drawable/ic_info"
        app:drawableTint="@color/danger"
        android:textColor="@color/danger"
        android:textSize="@dimen/text_body_sm"
        android:lineSpacingMultiplier="1.3"
        android:textIsSelectable="true" />
</LinearLayout>
