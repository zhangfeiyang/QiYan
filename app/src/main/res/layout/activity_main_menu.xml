<?xml version="1.0" encoding="utf-8"?>
<!--
  主菜单.

  旧版是 1 个实心按钮 + 3 个一模一样的描边按钮竖着排, 除了"填充还是描边"
  没有任何主次, 四个入口在视觉上等重. 现在分三档:
    1. 开始对弈 —— 唯一的实心行动色, 带图标, 字号最大
    2. 实时支招 —— 独占一行的卡片. 它是唯一"举着手机对着真实棋盘"的功能,
       和另外两个"在手机里看棋"的入口不是一回事, 塞进双列会被当成同类。
       四个字说不清它干什么, 所以配一句副标题。
    3. 复盘 / 拍照识局 —— 并列双列, 它们本来就是平级的两个功能
    4. 设置 / 关于 —— 底部文字按钮, 低频
  档案卡加了胜率条: 原来"胜/负/和"是三个孤立数字, 看不出走势.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_base"
    tools:context=".ui.menu.MainMenuActivity">

    <!-- 品牌头: 一枚印章 + 字标.
         原来这里只有一个 Toolbar 标题"QiYan", 和任何一个安卓应用的标题栏
         没有区别 —— 打开首页看不出这是一个象棋应用. 印章里的「棋」和红黑
         配色是这个 App 唯一需要的身份标记, 不必再画图标. -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/brand_seal"
                android:layout_width="@dimen/icon_lg"
                android:layout_height="@dimen/icon_lg"
                android:background="@drawable/bg_brand_seal"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/brand_seal_char"
                android:textColor="@color/piece_text"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2"
                android:text="@string/app_name"
                android:textAppearance="@style/TextAppearance.Xiangqi.Headline"
                android:textColor="@color/action" />

        </LinearLayout>

    </com.google.android.material.appbar.MaterialToolbar>

    <!-- ============ 档案卡 ============ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/profile_card"
        style="@style/Widget.Xiangqi.Card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_gutter"
        android:layout_marginTop="@dimen/space_2"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_4">

            <!-- 昵称 + 段位同一行: 段位是身份的一部分, 不该被塞进统计格子 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/nickname"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Xiangqi.Title"
                    tools:text="棋友" />

            </LinearLayout>

            <!-- 这张卡的主角: 原来显示裸分数(如"1500"), 现在改成段位名——
                 具体真人段位对应是否准确还没验证过, 裸分数看着像一个已经
                 标定好的外部量表, 段位名至少不虚报精度。
                 段位名比数字长得多(尤其英文"Amateur 3 Dan"), 用 autoSize
                 而不是固定字号, 免得中英文切换后某一侧被裁掉或换行。 -->
            <TextView
                android:id="@+id/rating_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="16sp"
                android:autoSizeMaxTextSize="@dimen/text_numeric"
                android:autoSizeStepGranularity="1sp"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                tools:text="1500" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rating_current"
                android:textAppearance="@style/TextAppearance.Xiangqi.Label" />

            <!-- 胜率条: 三段占比一眼可见. 权重由 Activity 按实际战绩设置 -->
            <LinearLayout
                android:id="@+id/winrate_bar"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="@dimen/space_4"
                android:orientation="horizontal"
                android:background="@drawable/bg_pill"
                android:clipToOutline="true">

                <View
                    android:id="@+id/winrate_win"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@color/affirm" />

                <View
                    android:id="@+id/winrate_loss"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@color/danger" />

                <View
                    android:id="@+id/winrate_draw"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@color/text_tertiary" />

            </LinearLayout>

            <!-- 图例, 颜色与上面的条一一对应 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/wins_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/affirm"
                    android:textSize="@dimen/text_body_sm"
                    android:textStyle="bold"
                    tools:text="胜 18" />

                <TextView
                    android:id="@+id/losses_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="@color/danger"
                    android:textSize="@dimen/text_body_sm"
                    android:textStyle="bold"
                    tools:text="负 12" />

                <TextView
                    android:id="@+id/draws_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_body_sm"
                    android:textStyle="bold"
                    tools:text="和 2" />

            </LinearLayout>

            <TextView
                android:id="@+id/games_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:textAppearance="@style/TextAppearance.Xiangqi.Label"
                tools:text="32" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- ============ 当前对手 ============ -->
    <!-- 原来"开始对弈"直接用上次的难度开局, 但首页上完全看不出上次是谁 ——
         按下去才知道自己要跟 Lv.2 还是 Lv.14 下。把对手摆到按钮正上方, 既
         回答了"我这一局要跟谁下", 又顺手做成换对手的入口。
         注意仍然保留"一键直接开局": 换对手是低频动作, 不该挡在每局前面。 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_opponent"
        style="@style/Widget.Xiangqi.Card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_gutter"
        android:layout_marginTop="@dimen/space_5"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:layout_constraintTop_toBottomOf="@id/profile_card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="@dimen/space_4">

            <TextView
                android:id="@+id/opponent_avatar"
                android:layout_width="@dimen/opponent_avatar"
                android:layout_height="@dimen/opponent_avatar"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textSize="@dimen/text_headline"
                android:textStyle="bold"
                tools:text="马" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_3"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/menu_current_opponent"
                    android:textAppearance="@style/TextAppearance.Xiangqi.Label" />

                <TextView
                    android:id="@+id/opponent_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textAppearance="@style/TextAppearance.Xiangqi.Title"
                    tools:text="Lv.4 Intermediate" />

                <TextView
                    android:id="@+id/opponent_segment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textAppearance="@style/TextAppearance.Xiangqi.Secondary"
                    tools:text="Street Player" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2"
                android:text="@string/menu_change_opponent"
                android:textColor="@color/action"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold"
                android:drawablePadding="2dp"
                app:drawableEndCompat="@drawable/ic_chevron_down"
                app:drawableTint="@color/action" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- ============ 主行动 ============ -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_play"
        style="@style/Widget.Xiangqi.Button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_gutter"
        android:layout_marginTop="@dimen/space_3"
        android:text="@string/menu_play"
        android:textSize="@dimen/text_title"
        app:icon="@drawable/ic_play"
        app:iconGravity="textStart"
        app:layout_constraintTop_toBottomOf="@id/card_opponent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ============ 实时支招: 独占一行 ============ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_live"
        style="@style/Widget.Xiangqi.Card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_gutter"
        android:layout_marginTop="@dimen/space_3"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:layout_constraintTop_toBottomOf="@id/btn_play"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="@dimen/space_4">

            <ImageView
                android:layout_width="@dimen/icon_md"
                android:layout_height="@dimen/icon_md"
                android:src="@drawable/ic_live"
                android:contentDescription="@string/live_entry"
                app:tint="@color/action" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_3"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/live_entry"
                    android:textAppearance="@style/TextAppearance.Xiangqi.Title" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:text="@string/menu_live_desc"
                    android:textAppearance="@style/TextAppearance.Xiangqi.Label" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- ============ 平级功能: 双列 ============ -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_replay"
        style="@style/Widget.Xiangqi.Button.Outlined"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_gutter"
        android:layout_marginEnd="@dimen/space_2"
        android:layout_marginTop="@dimen/space_3"
        android:text="@string/menu_replay"
        app:icon="@drawable/ic_history"
        app:iconGravity="textStart"
        app:iconSize="@dimen/icon_sm"
        app:layout_constraintTop_toBottomOf="@id/card_live"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_recognize" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_recognize"
        style="@style/Widget.Xiangqi.Button.Outlined"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_2"
        android:layout_marginEnd="@dimen/screen_gutter"
        android:text="@string/menu_recognize"
        app:icon="@drawable/ic_camera"
        app:iconGravity="textStart"
        app:iconSize="@dimen/icon_sm"
        app:layout_constraintTop_toTopOf="@id/btn_replay"
        app:layout_constraintStart_toEndOf="@id/btn_replay"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ============ 低频入口 ============ -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_settings"
        style="@style/Widget.Xiangqi.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_6"
        android:text="@string/menu_settings"
        app:icon="@drawable/ic_settings"
        app:iconGravity="textStart"
        app:iconSize="@dimen/icon_sm"
        app:layout_constraintTop_toBottomOf="@id/btn_replay"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_about"
        app:layout_constraintHorizontal_chainStyle="packed" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_about"
        style="@style/Widget.Xiangqi.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/menu_about"
        app:icon="@drawable/ic_info"
        app:iconGravity="textStart"
        app:iconSize="@dimen/icon_sm"
        app:layout_constraintTop_toTopOf="@id/btn_settings"
        app:layout_constraintBottom_toBottomOf="@id/btn_settings"
        app:layout_constraintStart_toEndOf="@id/btn_settings"
        app:layout_constraintEnd_toStartOf="@id/btn_language" />

    <!-- 中英文切换. 放在首页低频入口这一排, 跟设置/关于同一优先级 ——
         不是常用功能, 但要能一眼找到, 不该藏进设置二级菜单里. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_language"
        style="@style/Widget.Xiangqi.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/menu_language"
        app:icon="@drawable/ic_language"
        app:iconGravity="textStart"
        app:iconSize="@dimen/icon_sm"
        app:layout_constraintTop_toTopOf="@id/btn_settings"
        app:layout_constraintBottom_toBottomOf="@id/btn_settings"
        app:layout_constraintStart_toEndOf="@id/btn_about"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
