<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_home">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/brand_seal"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:background="@drawable/bg_brand_seal"
                android:text="@string/brand_seal_char"
                android:textColor="@color/piece_text"
                android:textSize="18sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFamily="serif"
                android:text="@string/app_name"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />
        </LinearLayout>
    </com.google.android.material.appbar.MaterialToolbar>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/home_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="20dp">
            <LinearLayout
                android:id="@+id/hero_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_lounge_hero"
                android:padding="22dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/home_eyebrow"
                    android:textSize="11sp"
                    android:textColor="@color/lounge_soft_gold"
                    android:letterSpacing="0.16" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="16dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/home_headline"
                            android:textSize="30sp"
                            android:textColor="@color/lounge_paper"
                            android:fontFamily="serif"
                            android:lineSpacingExtra="4dp" />
                    </LinearLayout>
                    <com.zhongguoxiangqi.ui.menu.ChessStillLifeView
                        android:layout_width="116dp"
                        android:layout_height="148dp"
                        android:importantForAccessibility="no"
                        android:id="@+id/hero_art" />
                </LinearLayout>
                <TextView
                    android:id="@+id/hero_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/home_intro"
                    android:textSize="13sp"
                    android:textColor="@color/lounge_muted"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="3dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_play"
                    style="@style/Widget.Xiangqi.Button.Gold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/home_start_practice"
                    android:layout_marginTop="20dp"
                    android:minHeight="56dp"
                    android:textSize="17sp"
                    app:icon="@drawable/ic_play"
                    app:iconGravity="textStart" />
            </LinearLayout>
            <!-- 当前对手: 它决定了上面「开始」按钮开出来的是哪一盘, 所以紧贴 hero.
                 以前隔着两张墨绿特色卡排在下面, 看起来像一个独立功能. -->
            <LinearLayout
                android:id="@+id/card_opponent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="80dp"
                android:paddingVertical="14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:id="@+id/opponent_avatar"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:textSize="24sp"
                    android:importantForAccessibility="no" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/opponent_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/difficulty_gentle"
                        android:textSize="15sp"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/opponent_segment"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/home_beginner_badge"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="3dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_change_opponent"
                        android:textColor="@color/lounge_link"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>
            <!-- 招牌特色: 实时支招 + 拍照识别. 紧跟 hero, 进首页一眼可见.
                 两张卡自带墨绿深底 (与 hero 同族), 夜间模式无需另配.
                 id 沿用旧工具行的 card_live / btn_recognize, 处理器零改动. -->
            <LinearLayout
                android:id="@+id/feature_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_live"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/lounge_ink"
                    app:strokeWidth="1dp"
                    app:strokeColor="#66DFC48B">
                    <LinearLayout
                        android:id="@+id/feature_live_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="148dp"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_feature_badge"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:text="@string/home_feature_badge"
                            android:textColor="@color/lounge_ink"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.08" />
                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_marginTop="12dp"
                            android:src="@drawable/ic_live"
                            app:tint="@color/lounge_soft_gold"
                            android:importantForAccessibility="no" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:fontFamily="serif"
                            android:text="@string/live_entry"
                            android:textColor="@color/lounge_paper"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="end"
                            android:lineSpacingExtra="2dp"
                            android:maxLines="3"
                            android:text="@string/home_live_desc"
                            android:textColor="@color/lounge_muted"
                            android:textSize="12sp" />
                    </LinearLayout>
                    <View
                        android:id="@+id/sheen_live"
                        android:layout_width="56dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_feature_sheen"
                        android:importantForAccessibility="no"
                        android:visibility="gone" />
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_recognize"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/lounge_ink"
                    app:strokeWidth="1dp"
                    app:strokeColor="#66DFC48B">
                    <LinearLayout
                        android:id="@+id/feature_recognize_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="148dp"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_feature_badge"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:text="@string/home_feature_badge"
                            android:textColor="@color/lounge_ink"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.08" />
                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_marginTop="12dp"
                            android:src="@drawable/ic_camera"
                            app:tint="@color/lounge_soft_gold"
                            android:importantForAccessibility="no" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:fontFamily="serif"
                            android:text="@string/menu_recognize"
                            android:textColor="@color/lounge_paper"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="end"
                            android:lineSpacingExtra="2dp"
                            android:maxLines="3"
                            android:text="@string/home_recognize_desc"
                            android:textColor="@color/lounge_muted"
                            android:textSize="12sp" />
                    </LinearLayout>
                    <View
                        android:id="@+id/sheen_recognize"
                        android:layout_width="56dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_feature_sheen"
                        android:importantForAccessibility="no"
                        android:visibility="gone" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_daily"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border_subtle"
                app:cardBackgroundColor="@color/lounge_daily">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/home_daily_title"
                        android:textSize="20sp"
                        android:textColor="@color/text_primary"
                        android:fontFamily="serif"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/home_daily_desc"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="6dp" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/home_daily_goal"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginTop="16dp" />
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/daily_progress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:indeterminate="false"
                        android:max="7"
                        app:trackThickness="4dp"
                        app:trackCornerRadius="2dp"
                        app:indicatorColor="@color/affirm"
                        app:trackColor="@color/border_subtle" />
                    <TextView
                        android:id="@+id/daily_streak"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/home_streak_start"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="8dp" />
                    <TextView
                        android:id="@+id/daily_action"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/home_daily_ready"
                        android:textSize="14sp"
                        android:textColor="@color/lounge_link"
                        android:layout_marginTop="16dp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_journey"
                android:textSize="21sp"
                android:textColor="@color/text_primary"
                android:fontFamily="serif"
                android:textStyle="bold"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="12dp" />
            <LinearLayout
                android:id="@+id/btn_campaign"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_surface_card"
                android:padding="20dp"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/home_campaign_title"
                    android:textSize="19sp"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/campaign_brief"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/home_campaign_desc"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="6dp" />
                <TextView
                    android:id="@+id/campaign_progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/home_campaign_title"
                    android:textSize="12sp"
                    android:textColor="@color/lounge_link"
                    android:layout_marginTop="14dp"
                    android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/btn_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="72dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="10dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_flag"
                    app:tint="@color/action"
                    android:importantForAccessibility="no" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/home_history_title"
                        android:textSize="16sp"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/history_home_sub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_back"
                    android:rotation="180"
                    app:tint="@color/text_tertiary"
                    android:importantForAccessibility="no" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/btn_puzzle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="76dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="12dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_hint"
                    app:tint="@color/action"
                    android:importantForAccessibility="no" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/home_puzzle_title"
                        android:textSize="16sp"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/home_puzzle_desc"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_back"
                    android:rotation="180"
                    app:tint="@color/text_tertiary"
                    android:importantForAccessibility="no" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/btn_catalog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="72dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="10dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_hint"
                    app:tint="@color/action"
                    android:importantForAccessibility="no" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/home_catalog_title"
                        android:textSize="16sp"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/catalog_home_sub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_back"
                    android:rotation="180"
                    app:tint="@color/text_tertiary"
                    android:importantForAccessibility="no" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/btn_rush"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="72dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="10dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_flag"
                    app:tint="@color/action"
                    android:importantForAccessibility="no" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/home_rush_title"
                        android:textSize="16sp"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/rush_home_sub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/home_rush_sub"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_back"
                    android:rotation="180"
                    app:tint="@color/text_tertiary"
                    android:importantForAccessibility="no" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/btn_tactics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="72dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="10dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_star_gold"
                    android:importantForAccessibility="no" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/home_tactics_title"
                        android:textSize="16sp"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tactics_home_sub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/home_tactics_sub"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_back"
                    android:rotation="180"
                    app:tint="@color/text_tertiary"
                    android:importantForAccessibility="no" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_tools"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="20dp"
                android:letterSpacing="0.08" />
            <LinearLayout
                android:id="@+id/btn_replay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="76dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="12dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_history"
                    app:tint="@color/action"
                    android:importantForAccessibility="no" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/menu_replay"
                        android:textSize="16sp"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/home_replay_desc"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_back"
                    android:rotation="180"
                    app:tint="@color/text_tertiary"
                    android:importantForAccessibility="no" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/profile_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="24dp"
                android:paddingBottom="12dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/home_profile_title"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp">
                    <TextView
                        android:id="@+id/nickname"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/rating_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/rank_seal"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_brand_seal"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:textColor="@color/piece_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/rank_progress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:lineSpacingExtra="2dp"
                            android:textColor="@color/lounge_link"
                            android:textSize="12sp" />
                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/rank_meter"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:indeterminate="false"
                            android:max="1000"
                            app:indicatorColor="@color/affirm"
                            app:trackColor="@color/border_subtle"
                            app:trackCornerRadius="2dp"
                            app:trackThickness="4dp" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/winrate_bar"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_pill"
                    android:clipToOutline="true">
                    <View
                        android:id="@+id/winrate_win"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:background="@color/affirm" />
                    <View
                        android:id="@+id/winrate_loss"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:background="@color/danger" />
                    <View
                        android:id="@+id/winrate_draw"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:background="@color/text_tertiary" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">
                    <TextView
                        android:id="@+id/games_value"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary" />
                    <TextView
                        android:id="@+id/wins_value"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary" />
                    <TextView
                        android:id="@+id/losses_value"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary" />
                    <TextView
                        android:id="@+id/draws_value"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_settings"
                    style="@style/Widget.Xiangqi.Button.Text"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/menu_settings" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_language"
                    style="@style/Widget.Xiangqi.Button.Text"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/menu_language" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_about"
                    style="@style/Widget.Xiangqi.Button.Text"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/menu_about" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
