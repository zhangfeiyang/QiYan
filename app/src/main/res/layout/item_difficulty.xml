<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_difficulty_item"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/space_4"
    android:layout_marginVertical="@dimen/space_1">

    <!-- 难度色条: 颜色由 Adapter 按档位设置 -->
    <View
        android:id="@+id/difficulty_badge"
        android:layout_width="4dp"
        android:layout_height="44dp"
        android:layout_marginEnd="@dimen/space_3" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 第一行: 档位名 + 段位标签. 把"对手大概什么水平"拉到这一行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/difficulty_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/difficulty_segment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2"
                android:background="@drawable/bg_pill"
                android:paddingHorizontal="@dimen/space_2"
                android:paddingVertical="2dp"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_caption" />

        </LinearLayout>

        <TextView
            android:id="@+id/difficulty_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_caption" />

    </LinearLayout>

</LinearLayout>