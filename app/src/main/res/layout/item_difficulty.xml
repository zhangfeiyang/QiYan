<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_difficulty_item"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/margin_medium"
    android:layout_marginVertical="@dimen/margin_tiny">

    <View
        android:id="@+id/difficulty_badge"
        android:layout_width="6dp"
        android:layout_height="40dp"
        android:layout_marginEnd="@dimen/margin_small" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/difficulty_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_large"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/difficulty_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_small" />

    </LinearLayout>

    <TextView
        android:id="@+id/difficulty_elo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="@dimen/margin_small"
        android:background="@color/bg_panel"
        android:textColor="@color/accent"
        android:textSize="@dimen/text_medium"
        android:textStyle="bold" />

</LinearLayout>