<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_page">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/new_game_title"
        app:titleTextColor="@color/text_primary"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="@color/text_primary" />
    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingBottom="24dp"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/new_game_guidance"
                android:textSize="25sp"
                android:fontFamily="serif"
                android:textColor="@color/text_primary"
                android:layout_marginTop="12dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/new_game_support"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="3dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="20dp" />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/opponent_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />
            <TextView
                android:id="@+id/training_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/new_game_style_training"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="12dp" />
            <LinearLayout
                android:id="@+id/style_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="20dp">
                <!-- ========== 对手棋路: 档位管"多强", 这里管"怎么下" ========== -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_2"
                    android:text="@string/new_game_style"
                    android:textAppearance="@style/TextAppearance.Xiangqi.Label" />
                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/style_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleSelection="true">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/style_balanced"
                        style="@style/Widget.Xiangqi.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/style_balanced" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/style_aggressive"
                        style="@style/Widget.Xiangqi.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/style_aggressive" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/style_solid"
                        style="@style/Widget.Xiangqi.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/style_solid" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/style_swarm"
                        style="@style/Widget.Xiangqi.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/style_swarm" />
                </com.google.android.material.button.MaterialButtonToggleGroup>
                <TextView
                    android:id="@+id/style_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:textAppearance="@style/TextAppearance.Xiangqi.Secondary"
                    tools:text="Loves captures, checks and sacrifices" />
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:layout_marginBottom="@dimen/space_2"
                android:text="@string/new_game_side"
                android:textAppearance="@style/TextAppearance.Xiangqi.Label" />
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/side_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/side_red"
                    style="@style/Widget.Xiangqi.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/side_red" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/side_random"
                    style="@style/Widget.Xiangqi.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/side_random" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/side_black"
                    style="@style/Widget.Xiangqi.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/side_black" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp"
        android:background="@color/surface_raised">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_start"
            style="@style/Widget.Xiangqi.Button.Gold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:text="@string/menu_play"
            android:textSize="@dimen/text_title"
            app:icon="@drawable/ic_play"
            app:iconGravity="textStart" />
    </LinearLayout>
</LinearLayout>
