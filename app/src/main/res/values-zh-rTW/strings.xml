    <string name="battle_1_name">長勺之戰</string>
    <string name="battle_1_brief">西元前684年，魯國曹劌等齊人三鼓氣竭再擊。這一局練鐵門栓，一步將死。</string>
    <string name="battle_2_name">城濮之戰</string>
    <string name="battle_2_brief">西元前632年，晉軍誘楚中軍前出，再從兩翼合圍。這一局練雙車錯。</string>
    <string name="battle_3_name">柏舉之戰</string>
    <string name="battle_3_brief">西元前506年，吳師長驅入郢。這一局練馬後砲。</string>
    <string name="battle_4_name">笠澤之戰</string>
    <string name="battle_4_brief">西元前478年，越軍分兩路渡江，擊破吳師。這一局練臥槽馬。</string>
    <string name="battle_5_name">桂陵之戰</string>
    <string name="battle_5_brief">西元前354年，齊軍直趨大梁，迫使圍趙的魏軍回救。這一局練重炮。</string>
    <string name="battle_6_name">馬陵之戰</string>
    <string name="battle_6_brief">西元前342年，孫臏逐日減灶，把龐涓引進狹道。這一局練釣魚馬。</string>
    <string name="battle_7_name">長平之戰</string>
    <string name="battle_7_brief">西元前260年，秦軍斷趙軍糧道，合圍四十餘萬眾。這一局練雙車錯。</string>
    <string name="battle_8_name">即墨之戰</string>
    <string name="battle_8_brief">西元前279年，田單夜開城門，衝進燕軍大營。這一局練臥槽馬。</string>
    <string name="battle_9_name">井陘之戰</string>
    <string name="battle_9_brief">西元前204年，韓信背水列陣，先示弱再反擊。這一局練白臉將。</string>
    <string name="battle_10_name">暗度陳倉</string>
    <string name="battle_10_brief">西元前206年，明修棧道，大軍另出陳倉。這一局練重炮。</string>
    <string name="battle_11_name">濰水之戰</string>
    <string name="battle_11_brief">西元前204年，韓信壅水誘敵半渡，再決堤。這一局練馬後砲。</string>
    <string name="battle_12_name">垓下之戰</string>
    <string name="battle_12_brief">西元前202年，漢軍四面合圍項羽。這一局練雙車錯。</string>
    <string name="battle_13_name">官渡之戰</string>
    <string name="battle_13_brief">建安五年，曹操襲燒袁紹在烏巢的軍糧。這一局練鐵門栓。</string>
    <string name="battle_14_name">赤壁之戰</string>
    <string name="battle_14_brief">建安十三年，火船衝進長江上連在一起的曹軍水寨。這一局練重炮。</string>
    <string name="battle_15_name">漢中之戰</string>
    <string name="battle_15_brief">建安二十四年，黃忠取定軍山，夏侯淵戰死。這一局練釣魚馬。</string>
    <string name="battle_16_name">夷陵之戰</string>
    <string name="battle_16_brief">章武二年，陸遜先避其鋒，再燒蜀軍連營。這一局練臥槽馬。</string>
    <string name="battle_17_name">淝水之戰</string>
    <string name="battle_17_brief">太元八年，苻堅的大軍一經後退就收不住。這一局練白臉將。</string>
    <string name="battle_18_name">虎牢之戰</string>
    <string name="battle_18_brief">武德四年，李世民在虎牢擊破竇建德。這一局練掛角馬。</string>
    <string name="battle_19_name">郾城之戰</string>
    <string name="battle_19_brief">紹興十年，岳家軍在郾城擊破金軍拐子馬。這一局練馬後砲。</string>
    <string name="battle_20_name">鄱陽湖之戰</string>
    <string name="battle_20_brief">元至正二十三年，朱元璋用火船破陳友諒的大艦。這一局練天地砲。</string>
