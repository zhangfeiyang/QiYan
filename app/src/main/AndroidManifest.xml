<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 引擎运行所需 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- 振动反馈 -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- 屏幕常亮 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 兼容旧版本 ARM 处理器 -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="true" />

    <!-- 64位必需 -->
    <uses-feature android:name="android.hardware.arm64" android:required="false" />

    <application
        android:name=".ZhongguoXiangqiApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ZhongguoXiangqi"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:requestLegacyExternalStorage="false"
        tools:targetApi="33">

        <activity
            android:name=".ui.menu.MainMenuActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.game.GameActivity"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:launchMode="singleTask"
            android:label="@string/title_game" />

        <activity
            android:name=".ui.replay.ReplayActivity"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:label="@string/title_replay" />

        <activity
            android:name=".ui.settings.SettingsActivity"
            android:screenOrientation="portrait"
            android:label="@string/title_settings" />

        <activity
            android:name=".ui.board.BoardEditorActivity"
            android:screenOrientation="portrait"
            android:label="@string/title_board_editor" />

    </application>
</manifest>