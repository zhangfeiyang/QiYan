<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        振动反馈. 这里只保留真正用到的权限:
        原先声明的 WAKE_LOCK / FOREGROUND_SERVICE 没有任何代码使用
        (应用里没有 Service, 也没有申请 WakeLock),
        "对局时屏幕常亮"改用 FLAG_KEEP_SCREEN_ON 实现, 不需要权限.
    -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- AI 分析走本地代理, 需要网络. 之前拍照识别和引擎都是进程内的, 不需要 INTERNET. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 实时支招要在应用内取相机流. 原来的"拍照"走的是系统相机 App,
         那种方式不需要这条权限, 所以之前一直没有. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <uses-feature android:name="android.hardware.touchscreen" android:required="true" />

    <application
        android:name=".ZhongguoXiangqiApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.ZhongguoXiangqi"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:requestLegacyExternalStorage="false"
        tools:targetApi="33">

        <activity
            android:name=".ui.menu.MainMenuActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.game.GameActivity"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:launchMode="singleTask"
            android:label="@string/title_game" />

        <activity
            android:name=".ui.replay.ReplayActivity"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:label="@string/title_replay" />

        <activity
            android:name=".ui.replay.ReplayViewerActivity"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:label="@string/title_replay" />

        <activity
            android:name=".ui.settings.SettingsActivity"
            android:screenOrientation="portrait"
            android:label="@string/title_settings" />

        <activity
            android:name=".ui.board.BoardEditorActivity"
            android:screenOrientation="portrait"
            android:label="@string/title_board_editor" />

        <!-- 实时支招: 相机常开, 横竖屏都可能用, 不锁方向 -->
        <activity
            android:name=".ui.live.LiveAdviceActivity"
            android:exported="false"
            android:theme="@style/Theme.ZhongguoXiangqi" />

        <activity
            android:name=".ui.recognize.RecognizeActivity"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:label="@string/title_recognize" />

        <activity
            android:name=".ui.advisor.AdvisorActivity"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:label="@string/advisor_title"
            android:windowSoftInputMode="adjustResize" />

        <!-- 拍照要把 file:// 换成 content://, 否则 Android 7+ 会抛 FileUriExposedException -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>